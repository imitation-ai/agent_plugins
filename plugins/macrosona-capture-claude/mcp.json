{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "macrosona": {
      "type": "streamable-http",
      "url": "https://mcp.macrosona.com/plugin/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "memory:read",
              "conversation:write"
            ]
          }
        }
      }
    }
  }
}
